<view class="container">
  <!-- 通用 -->
  <view class="section">
    <view class="section-label">通用</view>
    <view class="menu-group">
      <view class="menu-item" bindtap="onClearCache">
        <view class="menu-left">
          <view class="menu-icon">🗑️</view>
          <view class="menu-text">清除缓存</view>
        </view>
        <view class="menu-right">
          <view class="menu-hint">{{cacheSize}}</view>
          <view class="menu-arrow">→</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-label">关于</view>
    <view class="menu-group">
      <view class="menu-item" bindtap="onFeedback">
        <view class="menu-left">
          <view class="menu-icon">💬</view>
          <view class="menu-text">反馈建议</view>
        </view>
        <view class="menu-right">
          <view class="menu-arrow">→</view>
        </view>
      </view>
      <view class="menu-item" bindtap="onAbout">
        <view class="menu-left">
          <view class="menu-icon">📋</view>
          <view class="menu-text">关于我们</view>
        </view>
        <view class="menu-right">
          <view class="menu-hint">v{{appVersion}}</view>
          <view class="menu-arrow">→</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部品牌 -->
  <view class="footer">
    <view class="footer-logo">💬</view>
    <view class="footer-name">想好了说</view>
    <view class="footer-slogan">每一次表达，都是成长</view>
  </view>
</view>
